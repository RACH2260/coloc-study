{
  "expo": {
    "name": "Coloc'Study",
    "slug": "coloc-study",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.colocstudy.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1553D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.colocstudy.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Coloc'Study a besoin d'accéder à vos photos pour illustrer vos annonces et votre profil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#1553D6",
          "imageWidth": 160
        }
      ]
    ],
    "scheme": "colocstudy"
  }
}
